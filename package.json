{
  "name": "pupsiktv",
  "version": "1.0.0",
  "private": true,
  "description": "This repository contains the source code for the PupsikTV website. The project is a static site that relies on a few serverless API routes contained in the `api` directory.",
  "main": "index.js",
  "scripts": {
    "lint": "npm run lint:eslint && npm run lint:style && npm run format:check",
    "lint:eslint": "eslint .",
    "lint:style": "stylelint \"style/**/*.css\"",
    "format:check": "prettier --check \"*.json\" \"*.md\" \"eslint.config.js\" \".prettierrc.json\" \".stylelintrc.json\" \".github/**/*.{yml,yaml}\" \"api/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:write": "prettier --write \"*.json\" \"*.md\" \"eslint.config.js\" \".prettierrc.json\" \".stylelintrc.json\" \".github/**/*.{yml,yaml}\" \"api/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "test": "npm run lint && npm run build:pages && npm run test:node",
    "test:node": "node --test tests/*.test.mjs",
    "build:edge": "node scripts/build-edge.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:migration": "node --test tests/migration.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahoItz/PupsikTV.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MahoItz/PupsikTV/issues"
  },
  "homepage": "https://github.com/MahoItz/PupsikTV#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0"
  }
}
